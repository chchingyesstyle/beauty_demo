{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simple-beauty",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "beauty-demo.cchk.uk",
      "custom_domain": true
    }
  ]
}
