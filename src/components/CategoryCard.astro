---
interface Props {
  name: string;
  image: string;
  alt: string;
  copy: string;
  featured?: boolean;
}

const { name, image, alt, copy, featured = false } = Astro.props;
---

<article class:list={["category-card", { featured }]}>
  <div class="category-image">
    <img src={image} alt={alt} width="720" height="900" loading="lazy" />
    <span aria-hidden="true">Explore</span>
  </div>
  <div class="category-copy">
    <h3>{name}</h3>
    <p>{copy}</p>
  </div>
</article>
